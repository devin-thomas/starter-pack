{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.devthomas.site/schemas/recommendation.schema.json",
  "title": "Starter Pack Recommendation",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "phase",
    "requirement",
    "status",
    "recommended_by",
    "checked_at",
    "reason",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "phase-1",
        "phase-2",
        "phase-3",
        "cross-phase"
      ]
    },
    "requirement": {
      "enum": [
        "required",
        "recommended",
        "optional"
      ]
    },
    "status": {
      "enum": [
        "recommended",
        "alternative",
        "deprecated"
      ]
    },
    "recommended_by": {
      "const": "Devin Thomas"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "works_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replaced_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
