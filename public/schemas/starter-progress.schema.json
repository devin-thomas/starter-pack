{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.devthomas.site/schemas/starter-progress.schema.json",
  "title": "Starter Pack Progress",
  "type": "object",
  "required": [
    "schema_version",
    "starter_pack_version",
    "phase",
    "steps",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "starter_pack_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_access_ready": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "phase": {
      "type": "object",
      "required": [
        "current",
        "status"
      ],
      "properties": {
        "current": {
          "enum": [
            "phase-1",
            "phase-2",
            "phase-3"
          ]
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "completed"
          ]
        },
        "requirements_revision": {
          "type": "string"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "phase": {
            "enum": [
              "phase-1",
              "phase-2",
              "phase-3"
            ]
          },
          "next_action": {
            "type": "string"
          },
          "blocker": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "skipped",
              "deferred",
              "not_applicable"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "$ref": "#/$defs/capabilityVerification"
          }
        },
        "additionalProperties": true
      }
    },
    "choices": {
      "type": "object",
      "properties": {
        "development_email": {
          "type": "object",
          "properties": {
            "account_email": {
              "type": [
                "string",
                "null"
              ],
              "format": "email"
            },
            "notification_email": {
              "type": [
                "string",
                "null"
              ],
              "format": "email"
            },
            "access_email": {
              "type": [
                "string",
                "null"
              ],
              "format": "email"
            },
            "service_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "service_auth": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "account_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "account_email": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "email"
              },
              "source": {
                "type": "string"
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "workbench": {
          "type": "object",
          "properties": {
            "learner_name": {
              "type": "string"
            },
            "next_step_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "phase_3": {
          "$ref": "#/$defs/phase3Choice"
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "account_profile": {
          "type": "object",
          "properties": {
            "github_username": {
              "type": [
                "string",
                "null"
              ]
            },
            "service_usernames": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "recorded",
                "declined",
                "deferred"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "phase_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "phase",
              "status",
              "requirements_revision",
              "source"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "phase-1",
                  "phase-2",
                  "phase-3"
                ]
              },
              "status": {
                "enum": [
                  "not_started",
                  "in_progress",
                  "completed"
                ]
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "requirements_revision": {
                "type": "string"
              },
              "evidence_summary": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "programmatic_harness": {
          "$ref": "#/$defs/programmaticHarnessEvidence"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "programmaticHarnessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "target",
              "outcome"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "codex",
                  "cursor"
                ]
              },
              "target": {
                "enum": [
                  "local",
                  "cloud"
                ]
              },
              "outcome": {
                "enum": [
                  "not_tested",
                  "declined",
                  "deferred",
                  "partial",
                  "failed",
                  "passed"
                ]
              },
              "runtime_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "maxLength": 32
              },
              "auth_mode": {
                "enum": [
                  "managed_chatgpt",
                  "provider_managed"
                ]
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "first_file_verified": {
                "type": "boolean"
              },
              "second_file_verified": {
                "type": "boolean"
              },
              "same_session_resumed": {
                "type": "boolean"
              },
              "next_action": {
                "enum": [
                  "sign_in",
                  "update_runtime",
                  "retry_local",
                  "return_to_curriculum",
                  "await_release",
                  "separate_cloud_opt_in"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "provider": {
                      "const": "codex"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "local"
                    },
                    "auth_mode": {
                      "const": "managed_chatgpt"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "passed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "verified_at",
                    "first_file_verified",
                    "second_file_verified",
                    "same_session_resumed"
                  ],
                  "properties": {
                    "first_file_verified": {
                      "const": true
                    },
                    "second_file_verified": {
                      "const": true
                    },
                    "same_session_resumed": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "phase3Choice": {
      "description": "The learner's opt-in Phase 3 project and goal. Short nonsecret text only: never credentials, tokens, private data or logs.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_mode": {
          "enum": [
            "extend_phase_2",
            "existing_project",
            "new_project"
          ]
        },
        "project_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Repository or live URL, or the artifacts key of an existing project"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "What an agent should find, read or do"
        },
        "recommended_level": {
          "enum": [
            "agent-ready-website",
            "agent-cli",
            "agent-api",
            "agent-mcp",
            "agent-native-package"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "capabilityVerification": {
      "description": "Compact nonsecret proof for a Phase 3 capability step. Level 1 uses interface website; graduation needs cli, api or mcp, both checks passed and learner confirmation. Never store credentials, tokens, private data or raw logs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "client",
        "expected_output_check",
        "negative_case_check",
        "learner_confirmed"
      ],
      "properties": {
        "interface": {
          "enum": [
            "website",
            "cli",
            "api",
            "mcp"
          ]
        },
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The real agent or client that performed the check, with its version when known"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The command, HTTP method and path, MCP tool or public URL exercised"
        },
        "expected_output_check": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "negative_case_check": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "learner_confirmed": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "requirements_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "package_version": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^@?[a-z0-9][a-z0-9._/-]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "description": "Released package and exact version, for example @uppercut-labs/agent-native@1.0.1"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "One nonsecret sentence on what was checked"
        }
      }
    }
  }
}
