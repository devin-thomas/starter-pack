{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.devthomas.site/schemas/agent-catalog.schema.json",
  "title": "Starter Pack Agent Catalog",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "requirements_revision",
    "resources",
    "skills",
    "resource_links",
    "requirements",
    "progress",
    "workbench"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requirements_revision": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "summary",
          "markdown",
          "json"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "markdown": {
            "$ref": "#/$defs/resourceUrl"
          },
          "json": {
            "$ref": "#/$defs/resourceUrl"
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "html"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "html": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://starter\\.devthomas\\.site/phases/[123]#[a-z0-9-]+$"
                }
              }
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "html": {
            "$ref": "#/$defs/resourceUrl"
          }
        }
      }
    },
    "recommendations": {
      "$ref": "#/$defs/resourceUrl"
    },
    "artifacts": {
      "$ref": "#/$defs/resourceUrl"
    },
    "resource_links": {
      "$ref": "#/$defs/resourceUrl"
    },
    "requirements": {
      "$ref": "#/$defs/resourceUrl"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "current",
          "versioned"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "current": {
            "$ref": "#/$defs/resourceUrl"
          },
          "versioned": {
            "$ref": "#/$defs/resourceUrl"
          }
        }
      }
    },
    "workbench": {
      "type": "object",
      "required": [
        "download",
        "instructions",
        "catalog"
      ],
      "properties": {
        "download": {
          "$ref": "#/$defs/resourceUrl"
        },
        "instructions": {
          "$ref": "#/$defs/resourceUrl"
        },
        "catalog": {
          "$ref": "#/$defs/resourceUrl"
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "instructions",
        "template",
        "schema",
        "example"
      ],
      "properties": {
        "instructions": {
          "$ref": "#/$defs/resourceUrl"
        },
        "template": {
          "$ref": "#/$defs/resourceUrl"
        },
        "schema": {
          "$ref": "#/$defs/resourceUrl"
        },
        "example": {
          "$ref": "#/$defs/resourceUrl"
        }
      }
    }
  },
  "$defs": {
    "resourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://starter\\.devthomas\\.site/"
    }
  }
}
