{
  "name": "starter-pack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An accountless starter pack for making and deploying software with your own agent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devin-thomas/starter-pack.git"
  },
  "homepage": "https://starter.devthomas.site",
  "bugs": {
    "url": "https://github.com/devin-thomas/starter-pack/issues"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepare:startup": "tsx scripts/prepare-startup.ts",
    "check": "tsx scripts/prepare-startup.ts --check && npm run typecheck && npm run test:workbench && npm run test:startup && npm run build",
    "test:workbench": "tsx --test scripts/workbench.test.ts scripts/workbench-recovery.test.ts scripts/registry.test.ts",
    "test:startup": "tsx --test scripts/crawler-policy.test.ts scripts/companion-links.test.ts scripts/setup-contract.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run check && wrangler deploy && npm run verify:deployment",
    "verify:deployment": "tsx scripts/verify-deployment.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.12",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  }
}
