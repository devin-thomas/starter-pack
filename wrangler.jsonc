{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-pack",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "starter.devthomas.site",
      "custom_domain": true
    },
    {
      "pattern": "starter.uppercut-labs.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_TOTAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "LEGACY_HUMAN_REDIRECTS": "disabled"
  }
}
