{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-pack",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "starter.devthomas.site", "custom_domain": true }]
}
